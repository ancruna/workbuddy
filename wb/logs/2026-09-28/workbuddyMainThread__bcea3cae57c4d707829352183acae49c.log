buddy.cn","tencent.staging-sso.codebuddy.cn"],"internalDomain":["copilot.tencent.com","staging-copilot.tencent.com","www.codebuddy.cn","staging.codebuddy.cn","www.workbuddy.cn","staging.workbuddy.cn"],"platform":"workbuddy","prefixPath":"/plugin","startChatAfterCompleted":true,"tokenHeader":"Authorization","tokenType":"bearerToken","usernameEncode":"URLEncode","usernameHeader":"X-User-Id"},"id":"workbuddy-desktop","label":"TencentCloud","type":"cli-external-link"},"builtInAgentsName":["craft","ask","plan","debug","code-explorer"],"builtInMarketPlugins":[{"autoEnable":true,"marketplaceName":"codebuddy-plugins-official","name":"agent-browser","scope":"user"},{"autoEnable":true,"marketplaceName":"cb_teams_marketplace","name":"finance-data","scope":"user"}],"builtInMarketPluginsMerge":[{"autoEnable":true,"marketplaceName":"codebuddy-plugins-official","name":"agent-browser","scope":"user"}],"builtInMarketplaces":{"cb_teams_marketplace":{"metaUrl":"https://download.codebuddy.cn/plugin-marketplace/cb_teams_marketplace.json","source":"zip","url":"https://download.codebuddy.cn/plugin-marketplace/cb_teams_marketplace-ab2eb0bb-7465-4062-92d1-1df8288f86d1.zip","versionUrl":"https://download.codebuddy.cn/plugin-marketplace/version/cb_teams_marketplace.txt"},"codebuddy-plugins-official":{"metaUrl":"https://download.codebuddy.cn/plugin-marketplace/codebuddy-plugins-official.json","source":"zip","url":"https://download.codebuddy.cn/plugin-marketplace/codebuddy-plugins-official-4b9366ac-f7e5-4cef-b60a-99a5229ce2b2.zip","versionUrl":"https://download.codebuddy.cn/plugin-marketplace/version/codebuddy-plugins-official.txt"}},"builtInSkillMarketplaces":{"codebuddy-skill-official":{"source":"zip","url":"https://download.codebuddy.cn/skill-marketplace/skill-marketplace-66396a74-7070-456a-8be0-f05ae0cbb466.zip"}},"builtInSubagents":[{"content":"---\nname: code-explorer\ndescription: Subagent used whenever the task requires searching across multiple files, directories, or patterns, or when the scope of code exploration is too large for a single read_file or search_file call. This agent should be invoked for any non-trivial repository exploration.\ntools: search_file, search_content, read_file, list_files, read_lints, codebase_search\nagentMode: agentic\nenabled: true\nenabledAutoRun: true\n---\nYou are a file search specialist for Agent. You excel at thoroughly navigating and exploring codebases.\n\nYour strengths:\n\n* Rapidly finding files using **search_file** patterns\n* Searching code and text with powerful **search_content** regex patterns\n* Reading and analyzing file contents with **read_file**\n* Using **list_files** for listing directory contents (read-only)\n\nGuidelines:\n\n* Use **search_file** for broad file pattern matching\n* Use **search_content** for searching file contents with regex\n* Use **read_file** when you know the specific file path you need to read\n* Use **list_files** for listing directory contents\n* Adapt your search approach based on the thoroughness level specified by the caller\n* Return file paths as absolute paths in your final response\n* For clear communication, avoid using emojis\n* Do not create any files, or run bash commands that modify the user's system state in any way\n\nComplete the user's search request efficiently and report your findings clearly.\n\nNote：By default, invoke tools in parallel, not sequentially. When unsure, lean toward more parallel calls to maximize efficiency.","systemPrompt":"<code-explorer_subagent_usage>\nYou have `Task` tool to invoke the code-explorer subagent.\nUse it whenever a task requires broad codebase exploration rather than reading a few specific files.\nIt bundles tools like search_file, search_content, read_file, and list_files, making large-scale searches more efficient.\nUse code-explorer when:\n- You need to understand the structure of the codebase or folders.\n- Identifying modules, packages, or subprojects.\n- Finding where a feature, concept, or behavior is implemented.\n- Gathering information spread across many files.\n- Forming a high-level view of how the project is organized.\nSearches done via the subagent do not enter main-agent context, greatly reducing context size and token usage.\n</code-explorer_subagent_usage>","toolPrompt":""}],"commands":[{"description":"init is analyzing your codebase…","disableAutoAt":true,"name":"init","prompt":"init-prompt"},{"description":"Summarize conversation history","disableAutoAt":true,"name":"compact","prompt":"compact-prompt","tags":["compact-agent"]},{"description":"Clear conversation history but keep a summary in context. Optional: /compact [instructions for summarization]","name":"_compact","prompt":"compact-prompt"},{"description":"Open upgrade page in browser","name":"upgrade"},{"description":"Set up Codebuddy Code's status line UI","name":"statusline","prompt":"command-statusline-prompt"},{"allowedTools":["Bash(git diff:*)","Bash(git status:*)","Bash(git log:*)","Bash(git show:*)","Bash(git remote show:*)","Read","LS","Agent"],"description":"Complete a security review of the pending changes on the current branch","name":"security-review","prompt":"command-security-review-prompt","tags":["custom"]},{"allowedTools":["Bash(git add:*)","Bash(git status:*)","Bash(git commit:*)"],"description":"Create a git commit","name":"commit","prompt":"command-commit-prompt","tags":["custom"],"userInvocable":false},{"allowedTools":["Bash(git checkout -b:*)","Bash(git checkout --branch:*)","Bash(git add:*)","Bash(git status:*)","Bash(git commit:*)","Bash(git push:*)","Bash(git branch:*)","Bash(git log:*)","Bash(git diff:*)","Bash(gh pr create:*)","Bash(gh pr edit:*)","Bash(gh pr view:*)"],"description":"Commit, push, and open a PR","name":"commit-push-pr","prompt":"command-commit-push-pr-prompt","tags":["custom"],"userInvocable":false},{"description":"Generate AI-powered insights about your CodeBuddy Code usage patterns and activity","name":"insights","prompt":"command-insights-prompt"}],"commi