// ============================================================================
// AI Workflow Schema Definition
// ============================================================================
//
// 本文件定义了 AI 工作流系统的完整数据结构，包括：
// 1. 核心通信协议 - WebSocket 消息格式、版本同步、增量更新
// 2. 工作流数据结构 - 工作流实体、版本管理、节点与边
// 3. 画布基础类型 - GUID、颜色、向量、视口等基础类型
// 4. 节点与边定义 - 生成器节点、编辑器类型、连接关系
// 5. 节点参数类型 - 进度跟踪、视频参数、3D 模型参数
// 6. 页面原型相关 - 屏幕原型、需求文档、页面数据
// 7. 风格指南与主题 - 设计风格、Tailwind 主题配置
// 8. 编辑器数据结构 - 效果图编辑器、掩码数据、Logo 位置
//
// @package Schema
// @version 1.0.0
// @author Cocraft Team
//
package Schema;

// ============================================================================
// 第一部分：核心通信协议
// ============================================================================
//
// 定义 WebSocket 通信的消息格式、版本同步、增量更新等核心协议
//

// ----------------------------------------------------------------------------
// 消息类型枚举
// ----------------------------------------------------------------------------
// 定义客户端与服务端之间的通信消息类型
enum MessageType {
  VERSION = 0;       // 版本数据同步 - 用于全量同步工作流数据
  MUTATION = 1;      // 增量变更数据 - 用于实时协作的增量更新
  PARTICIPANT = 2;   // 协作成员集合 - 用于同步房间内的所有成员信息
  USER_CHANGES = 3;  // 用户状态变更 - 用于通知成员上线/下线状态
  JOIN_ROOM = 4;     // 加入协作房间 - 用于新成员加入房间时的握手
}

// ----------------------------------------------------------------------------
// 通信消息
// ----------------------------------------------------------------------------
// WebSocket 通信的核心消息结构
// 所有客户端与服务端的数据交换都通过此消息封装
message Message {
  uint sessionID = 1;           // 会话标识 - 标识当前客户端的唯一 ID
  uint ackID = 2;               // 确认消息 ID - 用于消息确认机制
  MessageType type = 3;         // 消息类型 - 决定如何解析后续字段
  Version version = 4;          // 版本数据 - type=VERSION 时使用，包含完整工作流快照
  Mutation mutation = 5;        // 变更数据 - type=MUTATION 时使用，包含增量变更
  Result result = 6;            // 操作结果 - 服务端响应时携带操作状态
  TracingInfo tracingInfo = 7;  // 链路追踪信息 - 用于分布式系统的调用链追踪
  UserChange[] userChanges = 8; // 用户变更列表 - type=USER_CHANGES 时使用
  string reconnectkey = 9;      // 重连密钥 - 用于断线重连时的身份验证
  int64 sequenceNumber = 10;    // 消息序列号 - 保证消息顺序，用于乱序处理
  bool isFullUpdate = 11;       // 是否全量更新用户列表 - true 时替换整个用户列表
}

// ----------------------------------------------------------------------------
// 操作结果
// ----------------------------------------------------------------------------
// 用于返回操作执行状态
// 服务端处理请求后通过此结构返回执行结果
message Result {
  string returnCode = 1;   // 业务错误码 - 如 "SUCCESS"、"INVALID_PARAM"
  uint statusCode = 2;     // HTTP 状态码 - 如 200、400、500
  string message = 3;      // 错误描述信息 - 供开发者调试使用
  bool canRetry = 4;       // 是否可重试 - true 时客户端可以重试该操作
}

// ----------------------------------------------------------------------------
// 链路追踪信息
// ----------------------------------------------------------------------------
// 用于分布式系统调用链追踪
// 支持在微服务架构中追踪请求的完整调用路径
message TracingInfo {
  string b3 = 1;           // B3 Propagation 格式的追踪 ID - 遵循 Zipkin B3 标准
}

// ----------------------------------------------------------------------------
// 用户状态变更
// ----------------------------------------------------------------------------
// 记录协作用户的连接状态和个人信息
// 用于实时显示在线用户列表和权限管理
message UserChange {
  uint sessionID = 1;      // 用户会话 ID - 与 Message.sessionID 对应
  bool connected = 2;      // 是否在线 - true 表示用户在线，false 表示离线
  string name = 3;         // 用户名称 - 显示在协作者列表中
  Color color = 4;         // 用户颜色标识 - 用于区分不同用户的操作（如光标颜色）
  string imageURL = 5;     // 用户头像 URL - 显示用户头像
  bool canWrite = 6;       // 是否具有写权限 - false 时用户只能查看，不能编辑
  string userID = 7;
}

// ============================================================================
// 第二部分：工作流数据结构
// ============================================================================
//
// 定义工作流的核心数据结构，包括工作流实体、版本管理、增量更新
//

// ----------------------------------------------------------------------------
// 工作流响应
// ----------------------------------------------------------------------------
// API 接口返回的工作流数据包装
// 用于 HTTP 接口返回工作流的完整信息
message WorkflowResponse {
  int code = 1;            // 响应状态码 - 0 表示成功，非 0 表示失败
  string message = 2;      // 响应消息 - 成功时为 "success"，失败时为错误描述
  Workflow data = 3;       // 工作流数据 - 包含完整的工作流实体信息
}

// ----------------------------------------------------------------------------
// 工作流
// ----------------------------------------------------------------------------
// 完整的工作流实体
// 代表一个完整的 AI 工作流项目
message Workflow {
  string id = 1;           // 工作流唯一标识 - 数据库主键
  int sessionId = 2;       // 关联会话 ID - 用于协作房间标识
  Version data = 3;        // 版本数据 - 工作流的当前版本快照
  int64 createAt = 4;      // 创建时间 - 毫秒时间戳
  int64 updateAt = 5;      // 更新时间 - 毫秒时间戳，每次修改都会更新
  string title = 6;        // 工作流标题 - 用户自定义的项目名称
}

// ----------------------------------------------------------------------------
// WorkBuddy 本地预览文件（.miora）
// ----------------------------------------------------------------------------
// WorkBuddy 本地 `.miora` 产物的根类型：把 Workflow 包一层信封，
// 便于携带预览所需的元信息。仅用于离线单文件预览，
// 不参与 WebSocket 协作协议，也不作为任何 HTTP 接口的出入参。
//
// ⚠️ 语义差异：此形态下 NodeData.fileKeys 不再是 COS fileKey，
// 而是「相对 assetsBaseDir 的本地文件路径」，由宿主以同源静态服务提供。
message MioraLocalFile {
  uint formatVersion = 1;   // 格式版本 - 当前为 1；缺省时解出 undefined，故读到非 1 一律视为非法/过旧
  Workflow workflow = 2;    // 画布数据 - 与 WorkflowResponse.data 同构
  string assetsBaseDir = 3; // 资源相对基准目录 - 相对 .miora 自身所在目录，缺省等价于 "."
  string generator = 4;     // 生成方标识 - 便于排查产物来源（可选）
}

// ----------------------------------------------------------------------------
// 版本数据
// ----------------------------------------------------------------------------
// 工作流的完整快照
// 包含工作流在某一时刻的所有节点和边的状态
message Version {
  string desc = 1;                   // 版本描述 - 用于版本管理的说明信息
  NodeChange[] nodeChanges = 2;      // 节点变更列表 - 包含所有节点（含页面节点）的完整状态
  EdgeChange[] edgeChanges = 3;      // 边变更列表 - 包含所有连接线的完整状态
  GUID activePageId = 4;             // 当前激活页面 ID - 用户当前查看的页面
  int64 createAt = 5;                // 创建时间 - 毫秒时间戳
  int64 updateAt = 6;                // 更新时间 - 毫秒时间戳
}

// ----------------------------------------------------------------------------
// 增量变更
// ----------------------------------------------------------------------------
// 工作流的增量更新数据
// 用于实时协作时的增量同步，避免传输完整数据
message Mutation {
  NodeChange[] nodeChanges = 1;      // 节点变更列表 - 仅包含变更的节点
  EdgeChange[] edgeChanges = 2;      // 边变更列表 - 仅包含变更的边
  GUID targetPageId = 3;             // 目标页面 ID - 变更所属的页面
  Viewport pageViewport = 4;         // 页面视口状态 - 画布的缩放和平移状态
  GUID activePageId = 5;             // 激活页面 ID - 用户切换页面时使用
  int64 createAt = 6;                // 变更时间 - 毫秒时间戳
}

// ============================================================================
// 第三部分:画布基础类型
// ============================================================================
//
// 定义画布系统的基础数据类型，包括坐标、颜色、视口等
//

// ----------------------------------------------------------------------------
// 全局唯一标识符 (GUID)
// ----------------------------------------------------------------------------
// 由会话 ID 和本地 ID 组合生成的全局唯一标识
// 用于在分布式协作环境中唯一标识节点和边
// 格式: sessionID (32位) + localID (32位) = 64位唯一 ID
struct GUID {
  uint sessionID;          // 会话标识 - 客户端的唯一 ID
  uint localID;            // 本地自增 ID - 在单个客户端内自增
}

// ----------------------------------------------------------------------------
// 颜色
// ----------------------------------------------------------------------------
// RGBA 颜色值定义
// 所有通道值范围为 0.0 到 1.0
struct Color {
  float r;                 // 红色通道 (0.0-1.0)
  float g;                 // 绿色通道 (0.0-1.0)
  float b;                 // 蓝色通道 (0.0-1.0)
  float a;                 // 透明度 (0.0-1.0，1.0 为完全不透明)
}

// ----------------------------------------------------------------------------
// 二维向量
// ----------------------------------------------------------------------------
// 用于表示位置坐标
// 坐标系原点在画布左上角，x 向右为正，y 向下为正
struct Vector {
  float x;                 // X 坐标 (像素)
  float y;                 // Y 坐标 (像素)
}

// ----------------------------------------------------------------------------
// 父节点索引
// ----------------------------------------------------------------------------
// 用于建立节点层级关系
// 支持将节点嵌套在其他节点内部
struct ParentIndex {
  GUID guid;               // 父节点 GUID - 指向父节点的唯一标识
  string position;         // 在父节点中的位置标识 - 用于排序和布局
}

// ----------------------------------------------------------------------------
// 画布视口
// ----------------------------------------------------------------------------
// 记录画布的缩放和平移状态
// 用于保存和恢复用户的视图状态
message Viewport {
  float x = 1;             // X 轴偏移量 - 画布水平平移距离（像素）
  float y = 2;             // Y 轴偏移量 - 画布垂直平移距离（像素）
  float zoom = 3;          // 缩放比例 - 1.0 为 100%，0.5 为 50%，2.0 为 200%
}

// ----------------------------------------------------------------------------
// 节点生命周期阶段
// ----------------------------------------------------------------------------
enum Phase {
  CREATED = 0;             // 已创建 - 节点正常存在
  REMOVED = 1;             // 已删除 - 节点被标记为删除（软删除）
}

// ----------------------------------------------------------------------------
// 连接点位置
// ----------------------------------------------------------------------------
// 定义节点连接点的方位
// 用于指定边的连接位置
enum Position {
  LEFT = 0;                // 左侧连接点
  RIGHT = 1;               // 右侧连接点
  TOP = 2;                 // 顶部连接点
  BOTTOM = 3;              // 底部连接点
}

// ----------------------------------------------------------------------------
// 节点基础类型
// ----------------------------------------------------------------------------
enum NodeType {
  NONE = 0;                // 未定义类型
  PAGE = 1;                // 页面节点 - 用作画布容器，可包含多个子节点
  CUSTOM = 2;              // 自定义节点 - 具体类型由 NodeData.type 决定
}

// ----------------------------------------------------------------------------
// 边基础类型
// ----------------------------------------------------------------------------
enum EdgeType {
  NONE = 0;                // 未定义类型
  CUSTOM = 1;              // 自定义边 - 具体样式由 EdgeData 决定
}

// ============================================================================
// 第四部分：节点与边定义
// ============================================================================
//
// 定义工作流中的节点类型、编辑器类型以及节点和边的数据结构
//

// ----------------------------------------------------------------------------
// 自定义节点类型
// ----------------------------------------------------------------------------
// 定义工作流中所有可用的节点类型
// 每种类型对应不同的 AI 生成能力
enum CustomNodeType {
  NONE = 0;                      // 未定义类型
  IMAGE_GENERATOR = 1;           // 图片生成器节点 - 用于生成图片
  VIDEO_GENERATOR = 2;           // 视频生成器节点 - 用于生成视频
  THREE_D_GENERATOR = 3;         // 3D 模型生成器节点 - 用于生成 3D 模型
  MARKDOWN_GENERATOR = 4;        // Markdown 生成器节点 - 用于生成 Markdown 文档
  FRAME = 5;                     // 画板容器节点 - 用于组合多个子节点
  TEXT_LAYER = 6;                // 文字图层节点 - 轻量文字编辑
  UI_GENERATOR = 7;              // UI 生成器节点 - 用于生成 UI
  SHAPE = 8;                     // 形状节点 - SVG 矩形/椭圆等基础图形
  PAG_GENERATOR = 9;             // PAG 生成器节点 - 用于生成 PAG 透明视频
  FOUNTAIN_GENERATOR = 10;      // Fountain 生成器节点 - 渲染 Fountain 文本分镜画布（物理后缀 .fountain）
  GROUP = 11;                   // 编组容器节点 - 用于组织多个子节点
  AUDIO_CONTAINER = 12;         // 音频容器节点 - 承载音频上传 / 播放 / 波形展示 / 轻量截取
  PANORAMA_GENERATOR = 13;      // 全景图生成器节点 - 生成 720° 全景图
  DIRECTOR_3D = 14;             // 3D 导演台节点 - 3D 机位编排 / 视角控制
}

// ----------------------------------------------------------------------------
// 编辑器类型
// ----------------------------------------------------------------------------
// 定义各种编辑功能的类型
// 用于指定节点当前处于哪种编辑模式
enum EditType {
  NONE = 0;                      // 未定义类型
  EDIT = 1;                      // 通用编辑模式 - 基础编辑功能
  DESIGN_SKIN = 2;               // 效果图编辑器 - 用于将 Logo 应用到背景图上
  DESIGN_TEXT = 3;               // 文字替换编辑器 - 用于替换图片中的文字
  ADJUST_VIEW = 4;               // 视角调整编辑器 - 用于调整 3D 模型或图片视角
  RELIGHT = 5;                   // 重新打光编辑器 - 用于调整光照效果
  ACTION_GENERATE = 6;           // 动作生成编辑器 - 用于生成角色动作
  EXPAND = 7;                    // 扩图编辑器 - 用于图片外扩
  CROP = 8;                      // 裁剪编辑器 - 用于裁剪图片
  HIGH_DEFINITION = 9;           // 高清化编辑器 - 用于提升图片分辨率
  BACKGROUND_REMOVE = 10;        // 背景移除编辑器 - 用于去除图片背景
  ERASER = 11;                   // 橡皮擦工具 - 用于擦除图片区域
  PENCIL = 12;                   // 铅笔工具 - 用于手绘标注
  LAYER_EDIT = 13;               // 图层编辑器 - 用于编辑图片图层
  VIDEO_FPS  = 14;               // 视频帧率编辑器 - 用于调整视频帧率
  VECTORIZE  = 15;               // 矢量化编辑器 - 用于将图片转换为矢量图
}

// 定义节点运行状态的类型
// 用于指定节点当前的运行/处理状态
enum RunningStatus {
  NONE = 0;                      // 未定义状态
  NORMAL = 1;                    // 正常 - 节点处于空闲状态
  WAITING = 2;                   // 等待中 - 节点等待执行
  RUNNING = 3;                   // 运行中 - 节点正在执行任务
  SUCCEEDED = 4;                 // 执行成功 - 节点任务已完成
  LOCKED = 5;                    // 已锁定 - 节点不可操作
  EMPTY = 6;                     // 空节点 - 节点无内容
  PROCESSING = 7;                // 处理中 - 节点正在处理数据
  UPLOADING = 8;                 // 上传中 - 节点正在上传文件
  LOADING = 9;                   // 加载中 - 节点正在加载资源
  GENERATING = 10;               // AI 生成中 - 节点正在进行 AI 生成
}

// ----------------------------------------------------------------------------
// 节点变更
// ----------------------------------------------------------------------------
// 描述节点的创建、更新或删除
// 用于版本控制和增量同步
message NodeChange {
  GUID guid = 1;                     // 节点唯一标识
  Phase phase = 2;                   // 生命周期阶段 - CREATED 或 REMOVED
  ParentIndex parentIndex = 3;       // 父节点索引 - 用于建立节点层级关系
  NodeType type = 4;                 // 节点基础类型 - PAGE 或 CUSTOM
  bool visible = 5;                  // 是否可见 - false 时节点在画布上隐藏
  bool selected = 6;                 // 是否选中 - true 时显示选中态样式
  Vector position = 7;               // 节点位置 - 相对于父节点或画布的坐标
  Position targetPosition = 8;       // 目标连接点位置 - 入边的连接位置
  Position sourcePosition = 9;       // 源连接点位置 - 出边的连接位置
  float width = 10;                  // 节点宽度 (像素)
  float height = 11;                 // 节点高度 (像素)
  NodeData data = 12;                // 节点业务数据 - 存储节点的具体配置
  int64 zIndex = 13;                 // Z 轴索引 - 用于节点层级排序
}

// ----------------------------------------------------------------------------
// 节点业务数据
// ----------------------------------------------------------------------------
// 存储各类型节点的具体配置和内容
// 不同类型的节点使用不同的字段组合
message NodeData {
  // ========== 通用字段 ==========
  CustomNodeType type = 1;               // 节点类型 - 决定节点的功能
  string title = 2;                      // 节点标题 - 显示在节点顶部
  string desc = 3;                       // 节点描述 - 详细说明节点用途
  string[] connectedSourceHandleIds = 4; // 已连接的源连接点 ID 列表 - 记录出边连接点
  string[] connectedTargetHandleIds = 5; // 已连接的目标连接点 ID 列表 - 记录入边连接点

  // ========== 页面节点专用字段 ==========
  string pageName = 6;                   // 页面名称 - 显示在页面标签上
  int pageOrder = 7;                     // 页面排序顺序 - 用于页面标签的排列
  Viewport pageViewport = 8;             // 视口状态 - 保存该页面的缩放和平移状态
  int64 updateAt = 9;                   // 页面更新时间 - 毫秒时间戳
  NodeCover[] covers = 10;               // 页面封面图片 - 用于页面缩略图显示

  // ========== 生成器节点专用字段 ==========
  string viewMode = 11;                  // 视图模式 - 如 "grid"（网格）、"list"（列表）
  int selectedIndex = 12;                // 当前选中的资源索引 - 指向 fileKeys 数组的索引
  string[] fileKeys = 13;                // 文件 COS 键值数组 - 存储生成的图片/视频/3D 模型

  // ========== 编辑器相关字段 ==========
  EditType editType = 14;                // 当前编辑器类型 - 节点处于编辑态时使用
  string[] fileNames = 15;               // 文件友好名称数组 - 与 fileKeys 一一对应，用于在对话中显示

  // ========== Markdown 节点专用字段 ==========
  MarkdownRenderOptions renderOptions = 16;  // Markdown 渲染选项 - 用于配置 Markdown 渲染行为

  // ========== 生成器节点字段 ==========
  int fileVersion = 17;                 // 文件版本
  bool locked = 18;                  // 是否锁定 - true 时节点不可操作

  // ========== TextLayer 文字图层专用字段 ==========
  string text = 19;                     // 文字内容
  float fontSize = 20;                  // 字号 (px)
  string fontFamily = 21;               // 字体族
  string fontWeight = 22;               // 字重
  string color = 23;                    // 文字颜色 (HEX)
  string snapshot = 24;                 // 文字图层截图 fileKey
  bool italic = 25;                     // 是否斜体

  // ========== Shape / Frame / Group 视觉属性 ==========
  string fillColor = 26;                // 填充颜色 (HEX)
  string shapeType = 27;                // 形状子类型 (rectangle / ellipse)
  string strokeColor = 28;              // 边框颜色 (HEX)
  float strokeWidth = 29;               // 边框宽度 (px)
  float borderRadius = 30;              // 圆角半径 (px)

  // ========== 运行状态字段 ==========
  RunningStatus runningStatus = 31;     // 节点运行状态 - 记录节点当前的运行/处理状态

  // ========== 沙箱相关字段 ==========
  string sandboxPath = 32;              // 远程沙箱中的文件路径

  bool shouldAutoSyncSize = 33;          // 是否自动同步尺寸

  // ========== 前端会话态字段（后端可忽略/不持久化，仅为协议完整性纳入 Schema） ==========
  // 本地预览 URL - URL.createObjectURL(file) 产生的 blob: URL
  // 仅在产生它的浏览器会话内有效，刷新页面或换客户端即失效；后端无需存储
  // 用于上传过程及上传完成后的本地即时预览，避免等待后端资源回源
  string localPreviewUrl = 34;

  // 前端撤销/重做操作分组 ID - 同一组内的多次 dispatch 合并为单个历史条目
  // 上传完成/操作收尾阶段会被清空，属于临时运行时标识
  // 只在协议中占位以便节点在前端各层级之间流转时保持类型一致
  string historyGroupId = 35;
  // ========== 矢量化专用字段 ==========
  string sourceImageFileKey = 36;    // 矢量化源图片 fileKey - 刷新后重新矢量化时使用
  VectorizeParams vectorizeParams = 37; // 矢量化参数 - 当前生效的矢量化配置
  bool vectorizeCommitted = 38;      // 是否已确认矢量化结果 - true 时不再显示编辑面板
  // ========== Agent 媒体工具桥接字段 ==========
  string mediaToolCallId = 39;       // 生成该节点的媒体 toolCallId - 用于刷新后恢复 loading 节点
  string asyncTaskId = 40;           // 异步任务编号 - 用于刷新后恢复异步媒体任务 loading 节点

  // ========== 3D 绑骨专用字段 ==========
  FileKeyNameEntry[] fileKeyNameMap = 41;          // fileKey → 动作名映射（键值对数组）
  FileKeyMotionTypeEntry[] fileKeyMotionTypeMap = 42; // fileKey → motionType 映射（键值对数组）

  // ========== 音频容器专用字段 ==========
  string containerState = 43;        // 音频容器状态机：empty/uploading/ready/clipping/generating/failed/invalid
  float clipStart = 44;              // 截取起点（秒）- 仅 clipping/generating 状态有效
  float clipEnd = 45;                // 截取终点（秒）- 仅 clipping/generating 状态有效
  string sourceFileKey = 46;         // 截取来源 fileKey - 仅截取产生的容器有

  // ========== UI容器专用字段 ==========
  string originDevice = 47;          // UI容器原始设备(ai 生成时的设备类型)

  // ========== Pencil Shape 专用字段 ==========
  string pathData = 48;              // 铅笔笔迹 SVG path 数据
  float pathBoxWidth = 49;           // 铅笔笔迹原始 viewBox 宽度
  float pathBoxHeight = 50;          // 铅笔笔迹原始 viewBox 高度
  string pencilLineType = 51;        // 铅笔线型 (freehand / straight / arrow / curve / polyline)
  float rotation = 52;               // 铅笔笔迹旋转角度（度）
  bool flipX = 53;                   // 铅笔笔迹水平翻转
  bool flipY = 54;                   // 铅笔笔迹垂直翻转

  // ========== 3D 预览弹窗持久化 ==========
  // 全部 3D 预览数据收敛在单个嵌套 message（materialAdjust / 环境光 / 渲染模式 / 自定义 HDRI）。
  // 整块读-改-写，无字段级合并；映射见 convertor/node-data/three-d-preview-settings.ts
  ThreeDPreviewSettings threeDPreviewSettings = 55;
}

// 用于表示 Record<string, string> 的 fileKey → 动作名映射条目
message FileKeyNameEntry {
  string key = 1;    // 绑骨产物 fileKey
  string value = 2;  // 动作名（i18n 翻译后的显示名）
}

// 用于表示 Record<string, number> 的 fileKey → motionType 映射条目
message FileKeyMotionTypeEntry {
  string key = 1;   // 绑骨产物 fileKey
  int value = 2;    // motionType 整数值
}

// ----------------------------------------------------------------------------
// 矢量化参数
// ----------------------------------------------------------------------------
message VectorizeParams {
  string mode = 1;                   // 矢量化模式 (color / gray / bw)
  uint colorCount = 2;               // 颜色数量 (1-100，仅 color/gray 模式使用)
  int filterSpeckle = 3;             // 滤波强度 (0-4)
  int pathPrecision = 4;             // 路径精度 (1-8)
  float bwThreshold = 5;             // 黑白阈值 (0.0-1.0，仅 bw 模式使用)
}

// ----------------------------------------------------------------------------
// 3D 预览弹窗设置
// ----------------------------------------------------------------------------
// 单通道材质调节（金属度 / 粗糙度共用）
message MaterialChannel {
  float intensity = 1;               // 强度 (0.0-1.0)
  float contrast = 2;                // 对比度 (0.0-1.0)
}

// 材质调节参数（金属度 + 粗糙度两通道）
message MaterialAdjust {
  MaterialChannel metalness = 1;     // 金属度通道
  MaterialChannel roughness = 2;     // 粗糙度通道
}

// 3D 预览弹窗的全部持久化设置（对应 NodeData.threeDPreviewSettings）
message ThreeDPreviewSettings {
  MaterialAdjust materialAdjust = 1; // 材质调节（金属度/粗糙度 强度+对比度）
  float environmentRotation = 2;     // 环境贴图旋转角度 (度, 0-360)
  float envIntensity = 3;            // 环境光强度 (0.0-1.0)
  string hdriPreset = 4;             // HDRI 预设 (studio-soft/daylight/moonlight/sunset/indoor-warm/custom)
  bool envAutoRotate = 5;            // 环境贴图自动旋转开关
  string baseMode = 6;               // 基础渲染模式 (lit/unlit/white/normal)
  string hdriFileKey = 7;            // 自定义 HDRI 环境贴图 fileKey (.hdr/.exr)
  string hdriFileName = 8;           // 自定义 HDRI 原始文件名（环境面板显示用）
}

// 用于更新节点的封面图片
// 支持批量更新多个节点的封面
message NodeCover {
  GUID guid = 1;                     // 节点唯一标识 - 指定要更新封面的节点
  string cover = 2;                  // 封面图片 URL 或 fileKey - 支持 HTTP URL 或 COS Key
}

// ----------------------------------------------------------------------------
// 边变更
// ----------------------------------------------------------------------------
// 描述边的创建、更新或删除
// 用于连接节点，表示数据流向
message EdgeChange {
  GUID guid = 1;                     // 边唯一标识
  Phase phase = 2;                   // 生命周期阶段 - CREATED 或 REMOVED
  EdgeType type = 3;                 // 边基础类型 - 通常为 CUSTOM
  string name = 4;                   // 边名称 - 用于标识边的用途
  bool visible = 5;                  // 是否可见 - false 时边在画布上隐藏
  GUID source = 6;                   // 源节点 GUID - 边的起点节点
  string sourceHandle = 7;           // 源连接点 ID - 边连接到源节点的哪个连接点
  GUID target = 8;                   // 目标节点 GUID - 边的终点节点
  string targetHandle = 9;           // 目标连接点 ID - 边连接到目标节点的哪个连接点
  EdgeData data = 10;                // 边业务数据 - 存储边的交互状态
}

// ----------------------------------------------------------------------------
// 边业务数据
// ----------------------------------------------------------------------------
// 存储边的交互状态和类型信息
// 用于控制边的样式和行为
message EdgeData {
  CustomNodeType sourceType = 1;           // 源节点类型 - 用于样式适配
  CustomNodeType targetType = 2;           // 目标节点类型 - 用于样式适配
  bool hovering = 3;                       // 鼠标悬停状态 - true 时显示悬停样式
  bool isBundled = 4;                      // 是否为捆绑边 - 多条边合并显示时使用
  bool connectedNodeIsHovering = 5;        // 连接节点是否悬停 - 节点悬停时边也高亮
  bool connectedNodeIsSelected = 6;        // 连接节点是否选中 - 节点选中时边也高亮
}

// ============================================================================
// 第五部分：节点参数类型
// ============================================================================
//
// 定义各种生成器节点的参数配置
//

// ----------------------------------------------------------------------------
// 进度参数
// ----------------------------------------------------------------------------
// 用于跟踪生成任务的执行状态
// 客户端通过此参数实时显示生成进度
message ProgressParams {
  string status = 1;                 // 状态: "GENERATING"（生成中）| "SUCCESS"（成功）| "FAIL"（失败）
  int progress = 2;                  // 进度百分比 (0-100) - 生成任务的完成进度
  string error = 3;                  // 错误信息 - 失败时提供具体的错误描述
}

// ----------------------------------------------------------------------------
// 视频参数
// ----------------------------------------------------------------------------
// 视频生成节点的配置参数
// 用于控制视频生成的各项参数
message VideoParams {
  string aspectRatio = 1;                // 宽高比 - 如 "16:9"、"9:16"、"1:1"
  string resolution = 2;                 // 分辨率 - 如 "1920x1080"、"1280x720"
  int duration = 3;                      // 视频时长 (秒) - 生成视频的持续时间
  string firstFrameKey = 4;              // 首帧图片 COS Key - 视频起始帧的参考图片
  string lastFrameKey = 5;               // 尾帧图片 COS Key - 视频结束帧的参考图片
  string referenceVideoKey = 6;          // 参考视频 COS Key - 用于风格迁移或动作参考
  string[] referenceImageKeys = 7;       // 参考图片 COS Key 列表 - 多张参考图片
}

// ----------------------------------------------------------------------------
// 3D 模型参数
// ----------------------------------------------------------------------------
// 3D 生成节点的配置参数
// 用于控制 3D 模型生成的质量和格式
message MeshParams {
  string format = 1;                     // 模型格式 - 如 "glb"、"fbx"、"obj"、"gltf"
  string quality = 2;                    // 质量等级 - 如 "low"、"medium"、"high"
  int polyCount = 3;                     // 多边形数量 - 控制模型精度，越高越精细
  string textureResolution = 4;          // 纹理分辨率 - 如 "1024x1024"、"2048x2048"
  bool rigged = 5;                       // 是否包含骨骼绑定 - true 时模型可用于动画
}

// ============================================================================
// 第六部分：页面原型相关类型
// ============================================================================
//
// 定义页面原型和需求文档的数据结构
// 用于应用原型设计和需求管理
//

// ----------------------------------------------------------------------------
// 页面类型
// ----------------------------------------------------------------------------
// 定义页面的目标平台类型
enum PageType {
  app = 0;                 // 移动端应用页面 - 适配手机屏幕
  pc = 1;                  // 桌面端应用页面 - 适配电脑屏幕
}

// ----------------------------------------------------------------------------
// 屏幕原型
// ----------------------------------------------------------------------------
// 页面原型节点的数据结构
// 用于管理一组原型页面
message ScreenPrototypeType {
  PageType pageType = 1;                     // 页面类型 - 移动端或桌面端
  ScreenPrototypeItemType[] items = 2;       // 原型页面列表 - 包含所有原型页面
}

// ----------------------------------------------------------------------------
// 屏幕原型子项
// ----------------------------------------------------------------------------
// 单个原型页面的数据
// 记录每个原型页面的生成状态
message ScreenPrototypeItemType {
  string pageId = 1;                   // 页面 ID - 唯一标识原型页面
  string pageName = 2;                 // 页面名称 - 如 "登录页"、"首页"
  string codeId = 3;                   // 关联代码 ID - 生成的代码文件标识
  bool success = 4;                    // 生成是否成功 - true 表示原型生成成功
  string error = 5;                    // 错误信息 - 失败时提供错误描述（可选）
}

// ----------------------------------------------------------------------------
// 需求文档
// ----------------------------------------------------------------------------
// 需求文档节点的数据结构
// 用于定义应用的完整需求和页面结构
message FeaturePlanType {
  string an = 1;                       // 应用名称 (Application Name) - 项目名称
  string styleKey = 2;                 // 关联的风格 Key - 指向设计风格节点
  PageType pageType = 3;               // 页面类型 - 移动端或桌面端
  PageDataType[] pages = 4;            // 页面列表 - 应用包含的所有页面定义
}

// ----------------------------------------------------------------------------
// 页面数据
// ----------------------------------------------------------------------------
// 需求文档中的单个页面定义
// 描述一个页面的功能结构
message PageDataType {
  string id = 1;                       // 页面唯一标识 - 用于关联原型和代码
  string n = 2;                        // 页面名称 (Name) - 如 "用户中心"
  SectionType[] sections = 3;          // 页面区块列表 - 页面包含的功能区块
}

// ----------------------------------------------------------------------------
// 区块数据
// ----------------------------------------------------------------------------
// 页面中的功能区块定义
// 描述页面内的一个功能模块
message SectionType {
  string id = 1;                       // 区块唯一标识
  string n = 2;                        // 区块名称 (Name) - 如 "用户信息卡片"
  string d = 3;                        // 区块描述 (Description) - 详细说明区块功能和交互
}

// ============================================================================
// 第七部分：风格指南与主题配置
// ============================================================================
//
// 定义设计风格和 Tailwind CSS 主题配置
// 用于统一应用的视觉风格和设计规范
//

// ----------------------------------------------------------------------------
// 设计风格
// ----------------------------------------------------------------------------
// 风格指南节点的数据结构
// 定义应用的完整设计系统
message DesignStyleType {
  string name = 1;                       // 风格名称 - 如 "现代简约"、"科技感"
  string platform = 2;                   // 目标平台 - 如 "web"、"mobile"、"desktop"
  string colorMode = 3;                  // 颜色模式 - "light"（浅色）或 "dark"（深色）
  string content = 4;                    // 风格描述内容 - 详细说明设计理念和使用场景
  TailwindTheme tailwindTheme = 5;       // Tailwind CSS 主题配置 - 完整的设计变量定义
}

// ----------------------------------------------------------------------------
// Tailwind CSS 主题配置
// ----------------------------------------------------------------------------
// 定义完整的设计系统变量
// 与 Tailwind CSS 配置格式兼容
message TailwindTheme {
  ColorConfig colors = 1;                    // 颜色配置 - 定义色彩系统
  FontFamilyConfig fontFamily = 2;           // 字体家族 - 定义字体栈
  FontSizeConfig fontSize = 3;               // 字体大小 - 定义排版层级
  SpacingConfig spacing = 4;                 // 间距配置 - 定义布局间距
  BorderRadiusConfig borderRadius = 5;       // 圆角配置 - 定义圆角规范
  BorderWidthEntry[] borderWidth = 6;        // 边框宽度 - 键值对数组
  BorderColorConfig borderColor = 7;         // 边框颜色 - 定义边框色彩
  BoxShadowConfig boxShadow = 8;             // 阴影配置 - 定义阴影效果
}

// ----------------------------------------------------------------------------
// 颜色配置
// ----------------------------------------------------------------------------

// 颜色配置
// 定义应用的完整色彩系统
// 包含主题色、背景色、文本色、功能色等
message ColorConfig {
  PrimaryColor primary = 1;              // 主色调 - 品牌主题色
  BackgroundColor background = 2;        // 背景色 - 各层级容器背景
  TextColor text = 3;                    // 文本颜色 - 各层级文本色
  FunctionalColor functional = 4;        // 功能性颜色 - 状态反馈色
  AccentColorEntry[] accent = 5;         // 强调色 - 额外的主题色（键值对数组）
  ChartColor chart = 6;                  // 图表颜色 - 数据可视化色彩
}

// 主色调
// 品牌主题色及其变体
message PrimaryColor {
  string base = 1;                       // 基础色 - 默认使用的主题色
  string lighter = 2;                    // 浅色变体 - 用于悬停态或浅色背景
  string darker = 3;                     // 深色变体 - 用于按压态或强调
}

// 背景色
// 定义不同层级的容器背景色
message BackgroundColor {
  string page = 1;                       // 页面背景 - 最底层的页面背景色
  string containerPrimary = 2;           // 主容器背景 - 主要内容区域背景
  string containerSecondary = 3;         // 次容器背景 - 次要内容区域背景
  string containerInset = 4;             // 内嵌容器背景 - 嵌套容器背景
  string containerInsetStrong = 5;       // 强调内嵌容器背景 - 更深的嵌套容器背景
}

// 文本颜色
// 定义不同层级的文本颜色
message TextColor {
  string primary = 1;                    // 主要文本 - 标题和重要内容
  string secondary = 2;                  // 次要文本 - 辅助说明文字
  string tertiary = 3;                   // 三级文本 - 不重要的辅助信息
  string quaternary = 4;                 // 四级文本 - 最弱的文本层级
  string onDarkPrimary = 5;              // 深色背景主要文本 - 深色背景上的标题
  string onDarkSecondary = 6;            // 深色背景次要文本 - 深色背景上的辅助文字
  string link = 7;                       // 链接颜色 - 可点击文本的颜色
}

// 功能性颜色
// 用于状态反馈的语义化颜色
message FunctionalColor {
  string successDefault = 1;             // 成功状态 - 操作成功的反馈色
  string successLight = 2;               // 成功状态（浅色）- 浅色背景的成功色
  string errorDefault = 3;               // 错误状态 - 错误和危险的反馈色
  string errorLight = 4;                 // 错误状态（浅色）- 浅色背景的错误色
  string warningDefault = 5;             // 警告状态 - 警告和提醒的反馈色
  string warningLight = 6;               // 警告状态（浅色）- 浅色背景的警告色
  string functionDefault = 7;            // 信息状态 - 一般信息的反馈色
  string functionLight = 8;              // 信息状态（浅色）- 浅色背景的信息色
}

// 强调色条目
// 用于表示 Record<string, string> 类型
// 可定义多个自定义强调色
message AccentColorEntry {
  string key = 1;                        // 颜色名称 - 如 "accent1"、"highlight"
  string value = 2;                      // 颜色值 - 十六进制或 rgba 格式
}

// 图表颜色
// 用于数据可视化的色彩系统
message ChartColor {
  ChartPrimaryColor primary = 1;         // 主色系 - 主要数据系列使用
  ChartSecondaryColor secondary = 2;     // 次色系 - 次要数据系列使用
}

// 图表主色系
// 定义 5 个主要的图表颜色
message ChartPrimaryColor {
  string color1 = 1;                     // 图表主色 1
  string color2 = 2;                     // 图表主色 2
  string color3 = 3;                     // 图表主色 3
  string color4 = 4;                     // 图表主色 4
  string color5 = 5;                     // 图表主色 5
}

// 图表次色系
// 定义 5 个次要的图表颜色
message ChartSecondaryColor {
  string color1 = 1;                     // 图表次色 1
  string color2 = 2;                     // 图表次色 2
  string color3 = 3;                     // 图表次色 3
  string color4 = 4;                     // 图表次色 4
  string color5 = 5;                     // 图表次色 5
}

// ----------------------------------------------------------------------------
// 字体配置
// ----------------------------------------------------------------------------

// 字体家族配置
// 定义应用使用的字体栈
message FontFamilyConfig {
  string[] base = 1;                     // 基础字体栈 - 按优先级排列的字体列表
                                         // 例如: ["Inter", "PingFang SC", "sans-serif"]
}

// 字体大小配置
// 定义排版层级
// 与 Tailwind CSS 的 fontSize 配置格式对应
message FontSizeConfig {
  FontSizeItem caption = 1;              // 说明文字 - 最小的文字层级
  FontSizeItem bodySmall = 2;            // 小号正文 - 辅助性正文
  FontSizeItem bodyDefault = 3;          // 默认正文 - 主要正文文字
  FontSizeItem cardTitle = 4;            // 卡片标题 - 卡片组件的标题
  FontSizeItem pageTitle = 5;            // 页面标题 - 页面级标题
  FontSizeItem headline = 6;             // 大标题 - 重要的标题文字
  FontSizeItem display = 7;              // 展示文字 - 最大的展示性文字
}

// 字体大小项
// 对应 Tailwind 的 [fontSize, { lineHeight, fontWeight? }] 元组
message FontSizeItem {
  string fontSize = 1;                   // 字体大小 - 如 "14px"、"1rem"
  FontSizeOptions options = 2;           // 附加选项 - 行高和字重
}

// 字体大小选项
// 定义字体的附加属性
message FontSizeOptions {
  string lineHeight = 1;                 // 行高 - 如 "1.5"、"20px"
  string fontWeight = 2;                 // 字重 - 如 "400"、"bold"（可选）
}

// ----------------------------------------------------------------------------
// 间距与边框配置
// ----------------------------------------------------------------------------

// 间距配置
// 定义组件间的标准间距
message SpacingConfig {
  string tight = 1;                      // 紧凑间距 - 最小的间距值，如 "4px"
  string compact = 2;                    // 较小间距 - 较小的间距值，如 "8px"
  string standard = 3;                   // 标准间距 - 默认的间距值，如 "16px"
  string generous = 4;                   // 宽松间距 - 较大的间距值，如 "24px"
}

// 圆角配置
// 定义组件的圆角规范
message BorderRadiusConfig {
  string small = 1;                      // 小圆角 - 如 "4px"，用于按钮、输入框
  string medium = 2;                     // 中圆角 - 如 "8px"，用于卡片
  string large = 3;                      // 大圆角 - 如 "12px"，用于模态框、面板
}

// 边框宽度条目
// 用于表示 Record<string, string> 类型
message BorderWidthEntry {
  string key = 1;                        // 宽度名称 - 如 "default"、"thick"
  string value = 2;                      // 宽度值 - 如 "1px"、"2px"
}

// 边框颜色配置
// 定义不同场景的边框颜色
message BorderColorConfig {
  string default = 1;                    // 默认边框色 - 常规边框颜色
  string stronger = 2;                   // 强调边框色 - 更深的边框颜色
  string accent = 3;                     // 主题边框色 - 使用主题色的边框
  string focus = 4;                      // 聚焦边框色 - 输入框聚焦时的边框颜色
}

// ----------------------------------------------------------------------------
// 阴影配置
// ----------------------------------------------------------------------------

// 阴影配置
// 定义组件的阴影效果
message BoxShadowConfig {
  string subtle = 1;                           // 细微阴影 - 轻微的阴影效果，如 "0 1px 2px rgba(0,0,0,0.05)"
  string moderate = 2;                         // 中等阴影 - 适中的阴影效果，如 "0 4px 6px rgba(0,0,0,0.1)"
  string pronounced = 3;                       // 明显阴影 - 明显的阴影效果，如 "0 10px 15px rgba(0,0,0,0.15)"
  string cardHover = 4;                        // 卡片悬停阴影 - 卡片悬停时的阴影效果
  BoxShadowCustomEntry[] customShadows = 5;    // 自定义阴影 - 额外的自定义阴影配置（键值对数组）
}

// 自定义阴影条目
// 用于定义额外的阴影效果
message BoxShadowCustomEntry {
  string key = 1;                        // 阴影名称 - 如 "panel"、"modal"
  string value = 2;                      // 阴影值 - CSS box-shadow 属性值
}

// ============================================================================
// 第八部分：各类编辑器的数据
// ============================================================================
//
// 定义各种编辑器的数据结构
// 目前主要支持效果图编辑器（设计皮肤编辑器）
//

// ============================================================================
// 效果图编辑器数据结构
// ============================================================================

// ----------------------------------------------------------------------------
// 掩码数据
// ----------------------------------------------------------------------------
// 存储 RLE 编码的掩码信息
// 用于图像分割和区域选择
message MaskData {
  int sizeWidth = 1;                     // 掩码宽度 (像素)
  int sizeHeight = 2;                    // 掩码高度 (像素)
  string rle = 3;                        // RLE 编码数据 - 压缩的掩码数据
                                         // RLE (Run-Length Encoding) 游程编码，用于高效存储掩码
}

// ----------------------------------------------------------------------------
// Logo 位置信息
// ----------------------------------------------------------------------------
// 定义 Logo 在画布中的位置和尺寸
// 用于效果图编辑器中的 Logo 放置
message LogoPlacement {
  float x = 1;                           // X 坐标 (像素) - Logo 左上角的 X 坐标
  float y = 2;                           // Y 坐标 (像素) - Logo 左上角的 Y 坐标
  float width = 3;                       // Logo 宽度 (像素) - Logo 的显示宽度
  float height = 4;                      // Logo 高度 (像素) - Logo 的显示高度
  float rotation = 5;                    // 旋转角度 (度) - Logo 的旋转角度，0-360
}

// ----------------------------------------------------------------------------
// 设计皮肤编辑器配置
// ----------------------------------------------------------------------------
// 编辑器的高级配置选项
message DesignSkinEditorConfig {
  float logoScaleRatio = 1;              // Logo 缩放比例 (0.0-1.0) - 控制 Logo 相对于容器的大小
}

// ----------------------------------------------------------------------------
// 掩码条目
// ----------------------------------------------------------------------------
// 用于表示 Record<string, MaskData> 类型的键值对
message MaskEntry {
  string key = 1;                        // 掩码名称 - 如 "foreground"（前景）、"background"（背景）
  MaskData value = 2;                    // 掩码数据 - 对应的掩码信息
}

// ----------------------------------------------------------------------------
// 设计皮肤编辑器
// ----------------------------------------------------------------------------
// 效果图编辑器的完整数据结构
// 用于将 Logo 应用到背景图上，支持 3D 效果和区域选择
message DesignSkinEditor {
  string backgroundImage = 1;                // 背景图片 fileKey - 效果图的背景图片
  string displacementMap = 2;                // 深度图 fileKey - 用于生成 3D 效果的深度信息
  MaskEntry[] masks = 3;                     // 分割掩码集合 - 图像分割后的各个区域（键值对数组）
  string logoImage = 4;                      // Logo 图片 fileKey - 要应用的 Logo 图片
  LogoPlacement logoPlacement = 5;           // Logo 位置信息 - Logo 的位置、大小和旋转
  string targetMaskName = 6;                 // 目标掩码名称 - 指定要应用效果的区域
  DesignSkinEditorConfig config = 7;         // 编辑器配置 - 高级配置选项
}

// ----------------------------------------------------------------------------
// 工作流编辑器数据
// ----------------------------------------------------------------------------
// 编辑器的完整数据结构
// 用于保存和恢复编辑器状态
message WorkflowEditor {
  string id = 1;                             // 编辑器唯一标识 - 数据库主键
  string guid = 2;                           // 关联节点的 GUID - 指向所属节点
  string workflowId = 3;                     // 所属工作流 ID - 指向所属工作流
  EditType type = 4;                         // 编辑器类型 - 决定使用哪种编辑器
  DesignSkinEditor data = 5;                 // 编辑器数据 - 目前支持效果图编辑器
  string fileKey = 6;                        // 关联的文件 Key - 编辑的目标文件
}

// ----------------------------------------------------------------------------
// 工作流编辑器响应
// ----------------------------------------------------------------------------
// API 接口返回的编辑器数据包装
message WorkflowEditorResponse {
  int code = 1;                        // 响应状态码 - 0 表示成功，非 0 表示失败
  string message = 2;                  // 响应消息 - 成功时为 "success"，失败时为错误描述
  WorkflowEditor data = 3;             // 工作流编辑器数据 - 完整的编辑器信息
}

// ----------------------------------------------------------------------------
// 渲染掩码条目
// ----------------------------------------------------------------------------
// 用于表示 Record<string, string> 类型的键值对
// 映射掩码名称到掩码图片 fileKey
message RenderingMaskEntry {
  string key = 1;                        // 掩码名称 - 如 "foreground"、"background"
  string value = 2;                      // 掩码图片 fileKey - 对应的掩码图片文件
}

// ----------------------------------------------------------------------------
// 渲染效果图
// ----------------------------------------------------------------------------
// 新版效果图数据结构
// 相比 DesignSkinEditor，使用 fileKey 存储掩码图片而不是 MaskData
message Rendering {
  string backgroundImage = 1;                // 背景图片 fileKey - 效果图的背景图片
  string displacementMap = 2;                // 深度图 fileKey - 用于生成 3D 效果的深度信息
  RenderingMaskEntry[] masks = 3;            // 分割掩码集合 - 掩码名称到 fileKey 的映射（键值对数组）
  string logoImage = 4;                      // Logo 图片 fileKey - 要应用的 Logo 图片
  LogoPlacement logoPlacement = 5;           // Logo 位置信息 - Logo 的位置、大小和旋转
  string targetMaskName = 6;                 // 目标掩码名称 - 指定要应用效果的区域
  DesignSkinEditorConfig config = 7;         // 编辑器配置 - 高级配置选项
}

// ============================================================================
// 第九部分：Markdown 节点配置
// ============================================================================
//
// 定义 Markdown 节点的渲染配置选项
//

// ----------------------------------------------------------------------------
// Markdown 渲染选项
// ----------------------------------------------------------------------------
// 用于配置 Markdown 节点的渲染行为
// 控制 Markdown 解析和显示的各项参数
message MarkdownRenderOptions {
  bool gfm = 1;                          // 是否启用 GFM（GitHub Flavored Markdown）- 支持表格、删除线等扩展语法
  bool highlight = 2;                    // 是否自动高亮代码块 - 对代码块进行语法高亮显示
  string theme = 3;                      // 主题模式 - "light"（浅色主题）或 "dark"（深色主题）
}
